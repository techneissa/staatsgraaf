    "refresh-official": "bun pipelines/refresh-official.mjs",
    "merge": "bun pipelines/merge.mjs",
    "news": "bun pipelines/news.mjs",
    "translate": "bun pipelines/translate.mjs api",
    "changes": "bun pipelines/changes.mjs",
    "diff": "bun pipelines/diff.mjs",
    "contract": "bun scripts/check-contract.mjs",
    "check-links": "bun scripts/check-links.mjs",
    "test": "bun test pipelines web/lib",
    "format-dates": "python3 scripts/format-dates.py"
