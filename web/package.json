{
  "name": "staatsgraaf-web",
  "version": "0.1.0",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "scripts": {
    "tokens": "bun scripts/build-tokens.mjs",
    "build-graph": "bun scripts/build-graph.mjs",
    "build-search-index": "bun scripts/build-search-index.mjs",
    "build-dataset": "bun scripts/build-dataset.mjs",
    "build-peek-index": "bun scripts/build-peek-index.mjs",
    "build-panel-index": "bun scripts/build-panel-index.mjs",
    "build-thumbs": "bun scripts/build-thumbs.mjs",
    "prepare-data": "bun run tokens && bun run build-graph && bun run build-search-index && bun run build-peek-index && bun run build-panel-index && bun run build-thumbs && bun run build-dataset",
    "predev": "bun run prepare-data",
    "dev": "next dev",
    "prebuild": "bun run prepare-data",
    "build": "next build && bun scripts/prune-export.mjs",
    "typecheck": "tsc --noEmit",
    "check:contrast": "bun scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "lucide": "1.48.0",
    "morphicons": "1.7.1",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=20.9"
  }
}
