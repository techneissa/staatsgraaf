{
  "name": "nl-overheid-graph-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build-dataset": "node scripts/build-dataset.mjs",
    "predev": "npm run tokens && node scripts/build-graph.mjs && node scripts/build-search-index.mjs && node scripts/build-dataset.mjs",
    "dev": "next dev",
    "prebuild": "npm run tokens && node scripts/build-graph.mjs && node scripts/build-search-index.mjs && node scripts/build-dataset.mjs",
    "build": "next build && node scripts/prune-export.mjs",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
