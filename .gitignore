# research/raw is the local fetch cache of third-party pages. It is not published
# (docs/adr/0023-public-repository.md); the pipelines refetch and recreate it.
# Two things inside it are kept: the licence evidence (ADR 0014) and the hand
# review of portrait identities, which the portraits pipeline reads as input.
# The star form (not research/raw/**) is what lets the negations below work.
research/raw/*
!research/raw/portraits/
research/raw/portraits/*
!research/raw/portraits/licences/
!research/raw/portraits/review.json
# The licence evidence for the coats of arms (ADR 0029).
!research/raw/logos/
research/raw/logos/*
!research/raw/logos/licences/

# Agent batches, agent-written reports and templates. They stay on the maintainer's
# disk and never ship (docs/adr/0023-public-repository.md). research/qa keeps the
# three files the pipelines read and write.
research/desc/
research/validation-report*.md
research/qa/*
!research/qa/live-review-queue.md
!research/qa/live-run-latest.json
!research/qa/link-check.md
research/graph-variants/README.md
research/graph-variants/report.md
shared/workstream-template.md
scripts/purge-history.sh

# Re-fetchable news feed cache; never a data payload
pipelines/.cache/

# Derived at build time from data/ (web/scripts/build-dataset.mjs, build-search-index.mjs)
web/public/data/v1/
web/public/search-index.json

# Python bytecode from scripts/format-dates.py
__pycache__/

# Agent, prompt, plan, and operating files. They stay on the maintainer's disk
# and never ship (docs/adr/0023-public-repository.md).
AGENTS.md
CLAUDE.md
GEMINI.md
