{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://staatsgraaf.pages.dev/shared/output-envelope.schema.json",
  "title": "Workstream output envelope",
  "description": "Every research workstream writes exactly one JSON file matching this envelope. Entity arrays carry records shaped by the canonical schemas in schema/v1/ as named in x-validate-against. Facts without a source are dropped at merge; every non-trivial fact carries a source (URL, retrieval date, confidence) or is listed in gaps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workstream",
    "generatedAt",
    "endpointsUsed",
    "organizations",
    "positions",
    "people",
    "tenures",
    "memberships",
    "relations",
    "topics",
    "budgets",
    "sources",
    "media",
    "gaps"
  ],
  "properties": {
    "workstream": {
      "type": "string",
      "pattern": "^[A-Z]$",
      "description": "Single uppercase workstream letter. P is the live official-source refresh; Q to U are graph-rebuild workstreams."
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "endpointsUsed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "retrieved"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "retrieved": { "type": "string", "format": "date" },
          "notes": { "type": "string" }
        }
      }
    },
    "organizations": {
      "type": "array",
      "x-validate-against": "schema/v1/organization.schema.json",
      "items": { "type": "object" }
    },
    "positions": {
      "type": "array",
      "x-validate-against": "schema/v1/position.schema.json",
      "items": { "type": "object" }
    },
    "people": {
      "type": "array",
      "x-validate-against": "schema/v1/person.schema.json",
      "items": { "type": "object" }
    },
    "tenures": {
      "type": "array",
      "x-validate-against": "schema/v1/tenure.schema.json",
      "items": { "type": "object" }
    },
    "memberships": {
      "type": "array",
      "x-validate-against": "schema/v1/membership.schema.json",
      "items": { "type": "object" }
    },
    "relations": {
      "type": "array",
      "x-validate-against": "schema/v1/relation.schema.json",
      "items": { "type": "object" }
    },
    "topics": {
      "type": "array",
      "x-validate-against": "schema/v1/topic.schema.json",
      "items": { "type": "object" }
    },
    "budgets": {
      "type": "array",
      "x-validate-against": "schema/v1/budget.schema.json",
      "items": { "type": "object" }
    },
    "sources": {
      "type": "array",
      "x-validate-against": "schema/v1/source.schema.json",
      "items": { "type": "object" }
    },
    "media": {
      "type": "array",
      "x-validate-against": "schema/v1/media.schema.json",
      "items": { "type": "object" }
    },
    "elections": {
      "type": "array",
      "x-validate-against": "schema/v1/election.schema.json",
      "items": { "type": "object" }
    },
    "coalitions": {
      "type": "array",
      "x-validate-against": "schema/v1/coalition.schema.json",
      "items": { "type": "object" }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["what", "why", "endpoint", "resume"],
        "properties": {
          "id": { "type": "string", "description": "Optional stable id (gap:<letter>-<slug>) so a gap can be referred to from reports and plans" },
          "what": { "type": "string", "description": "The missing fact or unfilled entity" },
          "why": { "type": "string", "description": "Why it could not be confirmed (blocked, not published, ambiguous)" },
          "endpoint": { "type": "string", "description": "The URL or register where the gap can be filled" },
          "resume": { "type": "string", "description": "What a later run must do to fill it" }
        }
      }
    },
    "legalMappings": {
      "type": "array",
      "description": "Workstream H. Legal-basis assignments applied at merge. target is an entity id (org:... applies legalSource; pos:... applies legalBasis) or the selector subtype:<subtype>, which matches every organization of that subtype.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "legalSource", "sources"],
        "properties": {
          "target": { "type": "string" },
          "legalSource": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "retrieved", "confidence"],
              "properties": {
                "source": { "type": "string", "pattern": "^src:" },
                "retrieved": { "type": "string", "format": "date" },
                "confidence": { "enum": ["high", "medium", "low"] }
              }
            }
          },
          "notes": { "type": "string" }
        }
      }
    },
    "aliases": {
      "type": "array",
      "description": "Workstream J. Alias gazetteer. target is an entity id; alias is the surface form found in news text. Applied to the entity's aliases array at merge.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "target"],
        "properties": {
          "alias": { "type": "string" },
          "target": { "type": "string", "pattern": "^(org|pos|person|topic):" },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    }
  }
}
