{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "budget.schema.json",
  "$ref": "#/$defs/budget",
  "$defs": {
    "amountSet": {
      "type": ["object", "null"],
      "required": ["spendingBudget", "spendingActual", "revenue", "net", "nonprofit"],
      "additionalProperties": false,
      "properties": {
        "spendingBudget": { "type": ["number", "null"] },
        "spendingActual": { "type": ["number", "null"] },
        "revenue": { "type": ["number", "null"] },
        "net": { "type": ["number", "null"] },
        "nonprofit": { "type": ["number", "null"] }
      }
    },
    "budget": {
      "type": "object",
      "required": ["organization", "fiscalYear", "sources"],
      "additionalProperties": false,
      "properties": {
        "organization": { "type": "string", "pattern": "^org:" },
        "fiscalYear": { "type": "integer", "minimum": 1500, "maximum": 2200 },
        "unit": { "type": ["string", "null"], "minLength": 1 },
        "current": { "$ref": "#/$defs/amountSet" },
        "previous": { "$ref": "#/$defs/amountSet" },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["fiscalYear"],
            "additionalProperties": false,
            "properties": {
              "fiscalYear": { "type": "integer", "minimum": 1500, "maximum": 2200 },
              "spendingActual": { "type": ["number", "null"] },
              "revenue": { "type": ["number", "null"] }
            }
          }
        },
        "breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "amount", "type"],
            "additionalProperties": false,
            "properties": {
              "category": { "type": "string", "minLength": 1 },
              "amount": { "type": ["number", "null"] },
              "type": { "type": "string", "enum": ["spending", "revenue"] }
            }
          }
        },
        "rankings": { "type": "object" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/sourceRef" }
        }
      }
    }
  }
}
