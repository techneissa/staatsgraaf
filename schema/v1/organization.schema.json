{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "organization.schema.json",
  "$ref": "#/$defs/organization",
  "$defs": {
    "organization": {
      "type": "object",
      "required": ["id", "slug", "name", "type", "subtype", "branch", "level", "country", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^org:[a-z0-9][a-z0-9-]*$" },
        "slug": { "$ref": "common.schema.json#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "type": {
          "type": "string",
          "enum": ["department", "elected", "commission", "advisory", "dept_head", "constituency"]
        },
        "subtype": {
          "type": "string",
          "enum": [
            "kiesgerechtigden-nederland",
            "kiezers-caribisch-nederland",
            "tweede-kamer",
            "eerste-kamer",
            "provinciale-staten",
            "gemeenteraad",
            "algemeen-bestuur-waterschap",
            "eilandsraad",
            "europees-parlement",
            "ministerie",
            "agentschap",
            "uitvoeringsorganisatie",
            "inspectie",
            "zbo",
            "rwt",
            "toezichthouder",
            "rechterlijke-instantie",
            "hoge-college",
            "adviescollege",
            "planbureau",
            "kiesraad",
            "provincie",
            "gemeente",
            "waterschap",
            "openbaar-lichaam-bes",
            "samenwerkingsverband",
            "veiligheidsregio",
            "koepel",
            "defensieonderdeel",
            "koninkrijksorgaan",
            "land-regering",
            "staten-land",
            "staatscommissie",
            "commissie",
            "raad-van-advies"
          ]
        },
        "branch": {
          "type": "string",
          "enum": [
            "regering",
            "staten-generaal",
            "rechterlijke-macht",
            "hoge-colleges",
            "adviescolleges",
            "decentraal-provinciaal",
            "decentraal-lokaal",
            "waterschap",
            "caribisch-nederland",
            "koninkrijk",
            "zelfstandig"
          ]
        },
        "level": {
          "type": "string",
          "enum": ["rijk", "provinciaal", "regionaal", "lokaal", "caribisch", "koninkrijk"]
        },
        "country": { "type": "string", "pattern": "^[a-z][a-z-]*$" },
        "parent": { "$ref": "common.schema.json#/$defs/orgRef" },
        "partOf": {
          "type": "array",
          "items": { "type": "string", "pattern": "^org:" }
        },
        "description": { "type": ["string", "null"], "minLength": 1 },
        "legalSource": { "$ref": "common.schema.json#/$defs/legalRef" },
        "website": { "type": ["string", "null"], "pattern": "^https?://" },
        "address": {
          "description": "The visiting address of the body's main office, for the map link on its page. A council or board without an office of its own has none and shows the address of the body it governs. Sourced: the Register van Overheidsorganisaties, else an official page.",
          "type": ["object", "null"],
          "required": ["street", "city", "country", "source", "retrieved"],
          "additionalProperties": false,
          "properties": {
            "street": { "type": "string", "minLength": 1 },
            "postcode": { "type": ["string", "null"] },
            "city": { "type": "string", "minLength": 1 },
            "country": { "type": "string", "minLength": 1 },
            "building": { "type": ["string", "null"] },
            "source": { "type": "string", "pattern": "^src:" },
            "retrieved": { "$ref": "common.schema.json#/$defs/isoDate" }
          }
        },
        "established": { "$ref": "common.schema.json#/$defs/isoDateOrNull" },
        "dissolved": { "$ref": "common.schema.json#/$defs/isoDateOrNull" },
        "seatsCount": { "$ref": "common.schema.json#/$defs/nonNegativeInteger" },
        "employeeCount": {
          "type": "object",
          "required": ["budgeted", "actual", "year"],
          "additionalProperties": false,
          "properties": {
            "budgeted": { "$ref": "common.schema.json#/$defs/nonNegativeInteger" },
            "actual": { "$ref": "common.schema.json#/$defs/nonNegativeInteger" },
            "year": { "type": ["integer", "null"], "minimum": 1500, "maximum": 2200 }
          }
        },
        "images": {
          "type": "array",
          "items": { "type": "string", "pattern": "^media:" }
        },
        "logoEmbed": {
          "description": "The official logo on the body's own site, shown by loading it from there (ADR 0029, amendment 1). No copy is stored and no licence is claimed. linkOnly: the body reserved copyright, so only the link is shown.",
          "type": ["object", "null"],
          "required": ["url", "page", "retrieved", "linkOnly"],
          "additionalProperties": false,
          "properties": {
            "url": { "type": ["string", "null"], "pattern": "^https://" },
            "page": { "type": "string", "pattern": "^https://" },
            "retrieved": { "$ref": "common.schema.json#/$defs/isoDate" },
            "linkOnly": { "type": "boolean" }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/sourceRef" }
        }
      }
    }
  }
}
