{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chamber-plan.schema.json",
  "$ref": "#/$defs/chamberPlan",
  "$defs": {
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "segment": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/point" },
        "to": { "$ref": "#/$defs/point" }
      }
    },
    "seat": {
      "type": "object",
      "required": ["x", "y", "fractie"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "description": "Centre of the seat as the source draws it, in the plan's coordinates." },
        "y": { "type": "number" },
        "fractie": { "type": "string", "minLength": 1, "description": "Fractie as data/memberships.json names it (the membership's fractie field)." },
        "person": { "$ref": "common.schema.json#/$defs/personRef", "description": "The member in this seat, only when the source names them." },
        "block": { "type": "string", "enum": ["left", "right", "chair"], "description": "Bench block of a grid plan." },
        "chair": { "type": "boolean", "description": "The seat of the chair of the chamber." }
      }
    },
    "chamberPlan": {
      "type": "object",
      "required": ["id", "organization", "asOf", "coordinates", "seatBasis", "seats", "places", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^plan:[a-z0-9][a-z0-9-]*$" },
        "organization": { "type": "string", "pattern": "^org:", "description": "The chamber the plan seats." },
        "asOf": { "$ref": "common.schema.json#/$defs/isoDate", "description": "Date of the edition of the plan, or the retrieval date of a live page." },
        "coordinates": {
          "type": "string",
          "enum": ["pdf-points", "grid"],
          "description": "pdf-points: shape centres in points of the source page, origin top left, y down. grid: row and column of the source's markup, one unit per cell."
        },
        "seatBasis": {
          "type": "string",
          "enum": ["fractie", "person"],
          "description": "fractie: the source shows which fractie sits in each seat but not which member. person: the source names the member in each seat."
        },
        "seats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/seat" } },
        "places": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "chair": { "$ref": "#/$defs/point" },
            "clerk": { "$ref": "#/$defs/point" },
            "rostrum": { "$ref": "#/$defs/point" },
            "cabinet": { "type": "array", "items": { "$ref": "#/$defs/segment" }, "description": "The benches of the kabinet (vak-K), as centre lines." }
          }
        },
        "notes": { "type": ["string", "null"] },
        "source": { "$ref": "common.schema.json#/$defs/sourceRef" }
      }
    }
  }
}
