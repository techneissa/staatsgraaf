{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenure.schema.json",
  "$ref": "#/$defs/tenure",
  "$defs": {
    "tenure": {
      "type": "object",
      "required": ["id", "person", "position", "start", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^tenure:[a-z0-9][a-z0-9-]*$" },
        "person": { "type": "string", "pattern": "^person:" },
        "position": { "type": "string", "pattern": "^pos:" },
        "seat": { "$ref": "common.schema.json#/$defs/nonNegativeInteger" },
        "start": { "$ref": "common.schema.json#/$defs/isoDate" },
        "end": { "$ref": "common.schema.json#/$defs/isoDateOrNull" },
        "acting": { "type": "boolean" },
        "entryMode": {
          "type": ["string", "null"],
          "enum": ["benoemd", "benoemd-bij-kb", "gekozen", "waarnemend", "plaatsvervangend", "van-rechtswege", null]
        },
        "appointedBy": { "$ref": "common.schema.json#/$defs/orgRef" },
        "predecessor": { "$ref": "common.schema.json#/$defs/tenureRef" },
        "successor": { "$ref": "common.schema.json#/$defs/tenureRef" },
        "endReason": {
          "type": ["string", "null"],
          "enum": ["aftreden", "ontslag", "einde-termijn", "overlijden", "reorganisatie", null]
        },
        "source": { "$ref": "common.schema.json#/$defs/sourceRef" }
      }
    }
  }
}
