{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coalition.schema.json",
  "$ref": "#/$defs/coalition",
  "$defs": {
    "coalition": {
      "type": "object",
      "required": ["id", "government", "name", "parties", "start", "end", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^coalition:[a-z0-9][a-z0-9-]*$" },
        "government": { "type": "string", "pattern": "^org:", "description": "The regering the kabinet belongs to, for example org:regering." },
        "name": { "type": "string", "minLength": 1, "description": "Official kabinet name, for example Kabinet-Schoof." },
        "parties": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Party keys as used in web/lib/parties.ts, in the order of the coalition agreement."
        },
        "start": { "$ref": "common.schema.json#/$defs/isoDate", "description": "Date of the beëdiging." },
        "end": { "$ref": "common.schema.json#/$defs/isoDateOrNull", "description": "Date the kabinet ended, or null while sitting. A demissionair kabinet stays open until its successor is sworn in; use demissionairSince for the fall." },
        "demissionairSince": { "$ref": "common.schema.json#/$defs/isoDateOrNull" },
        "primeMinister": { "$ref": "common.schema.json#/$defs/personRef" },
        "agreement": { "$ref": "common.schema.json#/$defs/srcRef", "description": "Source id of the regeerakkoord or hoofdlijnenakkoord." },
        "kind": {
          "type": ["string", "null"],
          "enum": ["meerderheid", "minderheid", "rompkabinet", "zakenkabinet", null]
        },
        "notes": { "type": ["string", "null"] },
        "source": { "$ref": "common.schema.json#/$defs/sourceRef" }
      }
    }
  }
}
