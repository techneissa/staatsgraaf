{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news-item.schema.json",
  "$ref": "#/$defs/newsItem",
  "$defs": {
    "newsItem": {
      "type": "object",
      "required": ["id", "title", "url", "publisher", "published", "sources"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^news:[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "publisher": { "type": "string", "minLength": 1 },
        "published": { "$ref": "common.schema.json#/$defs/isoDateTime" },
        "summary": { "type": ["string", "null"], "minLength": 1 },
        "summaryMarkup": { "type": ["string", "null"], "minLength": 1 },
        "entities": {
          "type": "array",
          "items": { "type": "string", "pattern": "^(org|pos|person|topic):" }
        },
        "topics": {
          "type": "array",
          "items": { "type": "string", "pattern": "^topic:" }
        },
        "image": { "$ref": "common.schema.json#/$defs/mediaRef" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/sourceRef" }
        }
      }
    }
  }
}
