{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "news-item.schema.json",
  "$ref": "#/$defs/newsItem",
  "$defs": {
    "newsItem": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "publisher",
        "published",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^news:[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "published": {
          "$ref": "common.schema.json#/$defs/isoDateTime"
        },
        "language": {
          "type": "string",
          "enum": [
            "nl",
            "en"
          ],
          "description": "Language of the title and summary as published by the outlet. Absent means nl."
        },
        "publisherKind": {
          "type": "string",
          "enum": [
            "publieke-omroep",
            "krant",
            "commerciele-omroep",
            "online",
            "video",
            "nieuwsbrief",
            "blog",
            "vakmedia",
            "overheid"
          ],
          "description": "Kind of outlet. Absent means online."
        },
        "scope": {
          "type": "string",
          "enum": [
            "politiek"
          ],
          "description": "Set by the news run when the item comes from a feed or section that is wholly about Dutch politics and government and its text does not point abroad (docs/adr/0021, amendment 06-10-2026). Makes the item relevant by source. Never written by a feed and never a link. Absent means no scope."
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "summaryMarkup": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(org|pos|person|topic):"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^topic:"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Matched alias strings that produced the entity links, in the order matched."
        },
        "image": {
          "$ref": "common.schema.json#/$defs/mediaRef"
        },
        "imageUrl": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^https?://",
          "description": "Preview image URL exactly as supplied by the feed (enclosure, media:content or similar), normalized to https where possible. Shown as a remote preview credited to the outlet; a licensed local copy is the upgrade path and lives in image."
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/sourceRef"
          }
        }
      }
    }
  }
}
